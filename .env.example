# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Models (defaults shown)
# ---------------------------------------------------------------------------
CHAT_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32
# Each embedded text counts against the Gemini rate limit. The free tier allows
# 100 inputs/minute; lower batches across a window keep ingestion under it.
# Set to 0 to disable pacing (paid tiers).
EMBEDDING_INPUTS_PER_MINUTE=90
MAX_RETRIES=4
RETRY_BASE_DELAY_S=1.5

# ---------------------------------------------------------------------------
# Retrieval (defaults shown)
# ---------------------------------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=4
CANDIDATE_K=15
MIN_RETRIEVAL_SIMILARITY=0.52
MIN_SUPPORTING_CHUNKS=1
ENABLE_LEXICAL_RERANK=true
LEXICAL_WEIGHT=0.18
REQUIRE_CITATIONS=true

# ---------------------------------------------------------------------------
# Escalation policy (defaults shown)
# ---------------------------------------------------------------------------
# actions_only: escalate on billing/legal/security/account-action requests.
# always: escalate on any mention of a sensitive category, informational or not.
SENSITIVE_ESCALATION_MODE=actions_only
MAX_TURNS_BEFORE_ESCALATION=6
FRUSTRATION_STREAK_THRESHOLD=2
FRUSTRATION_SCORE_THRESHOLD=0.6
# Comma-separated extra regex-safe phrases that must always escalate.
EXTRA_SENSITIVE_TERMS=

# ---------------------------------------------------------------------------
# Paths (defaults are relative to the project root)
# ---------------------------------------------------------------------------
DATA_DIR=data
CHROMA_DIR=chroma_db
COLLECTION_NAME=nimbusdesk_kb
HANDOFF_DIR=handoffs
FEEDBACK_FILE=feedback/feedback.jsonl
